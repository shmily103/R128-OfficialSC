 TARGET_DEVICES += zyxel_wx5600-t0-ubootmod
+
+define Device/Zhao_7981R128
+  DEVICE_VENDOR := ZHAO
+  DEVICE_MODEL := 7981R128
+  DEVICE_VARIANT := (Compiled by Panzy)
+  DEVICE_DTS := mt7981b-Zhao-7981R128-mtkuboot
+  DEVICE_DTS_DIR := ../dts
+  SUPPORTED_DEVICES := Zhao,7981R128
+DEVICE_PACKAGES := \
+		kmod-mt7915e kmod-mt7981-firmware mt7981-wo-firmware \
+		-wpad-basic-mbedtls wpad-mesh-mbedtls \
+		kmod-usb2 kmod-usb3 kmod-usb-storage-uas kmod-usb-storage-extras \
+		kmod-fs-ext4 kmod-fs-vfat kmod-nls-utf8 e2fsprogs \
+		block-mount fdisk usbutils \
+		kmod-sfp kmod-i2c-gpio ethtool \
+		-dnsmasq dnsmasq-full kmod-bonding kmod-vrf
+  UBINIZE_OPTS := -E 5
+  BLOCKSIZE := 128k
+  PAGESIZE := 2048
+  IMAGE_SIZE := 114688k
+  KERNEL_IN_UBI := 1
+  IMAGES += factory.bin
+  IMAGE/factory.bin := append-ubi | check-size $$$$(IMAGE_SIZE)
+  IMAGE/sysupgrade.bin := sysupgrade-tar | append-metadata
+endef
+TARGET_DEVICES += Zhao_7981R128
