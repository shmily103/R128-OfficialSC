#!/bin/bash
set -e

# 1. 复制 DTS 新文件
curl -sSL https://raw.githubusercontent.com/shmily103/R128-OfficialSC/main/mt7981b-Zhao-7981R128-mtkuboot.dts -o target/linux/mediatek/dts/mt7981b-Zhao-7981R128-mtkuboot.dts

# 2. 追加 filogic.mk
cat << 'EOF' >> target/linux/mediatek/image/filogic.mk

define Device/Zhao_7981R128
  DEVICE_VENDOR := ZHAO
  DEVICE_MODEL := 7981R128
  DEVICE_VARIANT := (Compiled by Panzy)
  DEVICE_DTS := mt7981b-Zhao-7981R128-mtkuboot
  DEVICE_DTS_DIR := ../dts
  SUPPORTED_DEVICES := Zhao,7981R128
  DEVICE_PACKAGES := \
		kmod-mt7915e kmod-mt7981-firmware mt7981-wo-firmware \
		-wpad-basic-mbedtls wpad-mesh-mbedtls \
		kmod-usb2 kmod-usb3 kmod-usb-storage-uas kmod-usb-storage-extras \
		kmod-fs-ext4 kmod-fs-vfat kmod-nls-utf8 e2fsprogs \
		block-mount fdisk usbutils \
		kmod-sfp kmod-i2c-gpio ethtool \
		-dnsmasq dnsmasq-full kmod-bonding kmod-vrf
  UBINIZE_OPTS := -E 5
  BLOCKSIZE := 128k
  PAGESIZE := 2048
  IMAGE_SIZE := 114688k
  KERNEL_IN_UBI := 1
  IMAGES += factory.bin
  IMAGE/factory.bin := append-ubi | check-size $$(IMAGE_SIZE)
  IMAGE/sysupgrade.bin := sysupgrade-tar | append-metadata
endef
TARGET_DEVICES += Zhao_7981R128
EOF

# 3. 修改 01_leds
sed -i '/Zhao,7981R128)/,/;;/d' target/linux/mediatek/filogic/base-files/etc/board.d/01_leds 2>/dev/null || true
sed -i '340a\Zhao,7981R128)\n\tucidef_set_led_netdev "lan" "LAN" "LAN" "lan2"\n\tucidef_set_led_netdev "sfp" "SFP" "SFP" "eth1"\n\tucidef_set_led_netdev "wlan2g" "WIFI2G" "WIFI2G" "ra0"\n\tucidef_set_led_netdev "wlan5g" "WIFI5G" "WIFI5G" "rax0"\n\t;;' target/linux/mediatek/filogic/base-files/etc/board.d/01_leds

# 4. 修改 02_network
sed -i '326a\\\tZhao,7981R128)\n\t\tlan_mac=$(mtd_get_mac_binary "Factory" 0x04)\n\t\twan_mac=$(macaddr_add "$lan_mac" 1)\n\t\tlabel_mac=$lan_mac\n\t\t;;' target/linux/mediatek/filogic/base-files/etc/board.d/02_network

# 5. 修改 mediatek_filogic
sed -i '84s/$/Zhao,7981R128)/' package/boot/uboot-tools/uboot-envtools/files/mediatek_filogic

# 6. 修改 platform.sh
sed -i '358s/$/\tZhao,7981R128)/' target/linux/mediatek/filogic/base-files/lib/upgrade/platform.sh
